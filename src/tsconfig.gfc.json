{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@vendor/gfc/*": ["../vendor/gui-for-clash/frontend/*"],

      "@wails/*": ["../vendor/gui-for-clash/frontend/src/bridge/wailsjs/*"],

      "@/*": ["../src/*", "../vendor/gui-for-clash/frontend/src/*"]
    },

    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.gfc.tsbuildinfo"
  },
  "include": [
    "plugins/GFC/**/*",
    "types/**/*",
    "plugins.gfc.ts",
    "../vendor/gui-for-clash/frontend/**/*",
    "plugins.ts"
  ]
}
