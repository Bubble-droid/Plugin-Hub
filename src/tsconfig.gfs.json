{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@vendor/gfs/*": ["../vendor/gui-for-singbox/frontend/*"],

      "@wails/*": ["../vendor/gui-for-singbox/frontend/src/bridge/wailsjs/*"],

      "@/*": ["../src/*", "../vendor/gui-for-singbox/frontend/src/*"]
    },

    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.gfs.tsbuildinfo"
  },
  "include": [
    "plugins/GFS/**/*",
    "types/**/*",
    "plugins.gfs.ts",
    "../vendor/gui-for-singbox/frontend/**/*",
    "plugins.ts"
  ]
}
