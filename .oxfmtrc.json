{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "tabWidth": 2,
  "singleQuote": true,
  "printWidth": 80,
  "trailingComma": "all",
  "ignorePatterns": [
    ".agents",
    "archives",
    "dist",
    "vendor",
    "plugins.d.ts",
    "plugins/**/*{js,json}",
    "plugins/Resources/**"
  ],
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["*.md"],
      "options": {
        "embeddedLanguageFormatting": "off"
      }
    }
  ]
}
